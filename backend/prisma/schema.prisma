// Схема БД «НСРЗ. Заказ запчастей».
// Таблицы и связи — из формы «Этап 3» (п. 3.2). Добавлены для MVP:
//   stock.reserved      — резерв под активные заказы (заказ сразу резервирует деталь, план проекта п. 2);
//   orders.idempotency_key / content_hash — защита от повторной отправки одного и того же заказа;
//   auth_codes, refresh_tokens — коды входа и сессии (вместо Redis на первом этапе);
//   notifications       — журнал отправленных SMS и писем (интеграции).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER // судовладелец / судоходная компания
  SALES // сотрудник отдела продаж НСРЗ
  WAREHOUSE // сотрудник склада НСРЗ
  ADMIN // администратор системы
}

enum Availability {
  IN_STOCK // в наличии
  ON_ORDER // под заказ
  OUT_OF_STOCK // нет на складе
}

enum OrderStatus {
  PENDING // ожидает подтверждения
  CONFIRMED // подтверждён
  ASSEMBLING // комплектуется
  READY // готов к выдаче или отправлен
  COMPLETED // завершён
  REJECTED // отклонён
}

enum DeliveryMethod {
  PICKUP // самовывоз со склада НСРЗ
  TO_BOARD // доставка к борту судна
  CARRIER // транспортная компания
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  SENT // отправлено через внешний сервис
  LOGGED // демо-режим: записано в журнал, во внешний сервис не уходило
  FAILED
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  inn          String?  @unique
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")

  users   User[]
  vessels Vessel[]
  orders  Order[]
  tickets SupportTicket[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  phone     String?  @unique
  email     String?  @unique
  fullName  String   @map("full_name")
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company       Company?             @relation(fields: [companyId], references: [id])
  orders        Order[]
  cartItems     CartItem[]
  statusChanges OrderStatusHistory[]
  stockImports  StockImport[]
  stockUpdates  Stock[]
  refreshTokens RefreshToken[]
  tickets       SupportTicket[]      @relation("TicketAuthor")
  ticketReplies SupportTicket[]      @relation("TicketReplier")

  @@map("users")
}

model VesselType {
  id   Int    @id @default(autoincrement())
  name String @unique

  vessels Vessel[]
  parts   PartVesselType[]

  @@map("vessel_types")
}

model Vessel {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  vesselTypeId Int     @map("vessel_type_id")
  name         String
  imoNumber    String? @unique @map("imo_number")

  company    Company    @relation(fields: [companyId], references: [id])
  vesselType VesselType @relation(fields: [vesselTypeId], references: [id])
  orders     Order[]

  @@index([companyId])
  @@map("vessels")
}

model PartCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  parentId Int?    @map("parent_id")
  icon     String? // ключ значка для клиентов

  parent   PartCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children PartCategory[] @relation("CategoryTree")
  parts    Part[]

  @@map("part_categories")
}

model Part {
  id                     Int      @id @default(autoincrement())
  name                   String
  description            String?
  catalogNumber          String   @unique @map("catalog_number")
  manufacturerPartNumber String?  @map("manufacturer_part_number")
  // номера без пробелов, дефисов и точек в верхнем регистре — чтобы «6L20 FF 118» находил «6L20-FF-118»
  searchKey              String   @map("search_key")
  // наименование и описание в нижнем регистре (ё → е) — поиск по словам не зависит от локали БД
  searchText             String   @map("search_text")
  categoryId             Int      @map("category_id")
  price                  Decimal  @db.Decimal(12, 2)
  unit                   String   @default("шт.")
  leadTimeDays           Int      @default(0) @map("lead_time_days")
  imageUrl               String?  @map("image_url")
  createdAt              DateTime @default(now()) @map("created_at")

  category    PartCategory     @relation(fields: [categoryId], references: [id])
  vesselTypes PartVesselType[]
  stock       Stock?
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([manufacturerPartNumber])
  @@index([categoryId])
  @@index([searchKey])
  @@map("parts")
}

model PartVesselType {
  partId       Int @map("part_id")
  vesselTypeId Int @map("vessel_type_id")

  part       Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  vesselType VesselType @relation(fields: [vesselTypeId], references: [id])

  @@id([partId, vesselTypeId])
  @@index([vesselTypeId, partId])
  @@map("part_vessel_types")
}

model Stock {
  partId       Int          @id @map("part_id")
  quantity     Int          @default(0) // физически на складе
  reserved     Int          @default(0) // в активных заказах (ожидает подтверждения … готов к выдаче)
  availability Availability @default(IN_STOCK)
  updatedAt    DateTime     @default(now()) @map("updated_at")
  updatedById  String?      @map("updated_by") @db.Uuid

  part      Part  @relation(fields: [partId], references: [id], onDelete: Cascade)
  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("stock")
}

model StockImport {
  id           Int      @id @default(autoincrement())
  fileName     String   @map("file_name")
  importedById String   @map("imported_by") @db.Uuid
  rowsTotal    Int      @map("rows_total")
  rowsFailed   Int      @map("rows_failed")
  errors       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  importedBy User @relation(fields: [importedById], references: [id])

  @@map("stock_imports")
}

model CartItem {
  userId    String   @map("user_id") @db.Uuid
  partId    Int      @map("part_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([userId, partId])
  @@map("cart_items")
}

model Order {
  id             Int            @id @default(autoincrement())
  number         String         @unique
  userId         String         @map("user_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  vesselId       String         @map("vessel_id") @db.Uuid
  deliveryMethod DeliveryMethod @map("delivery_method")
  status         OrderStatus    @default(PENDING)
  comment        String?
  rejectReason   String?        @map("reject_reason")
  total          Decimal        @db.Decimal(14, 2)
  idempotencyKey String?        @unique @map("idempotency_key")
  contentHash    String         @map("content_hash")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id])
  company       Company              @relation(fields: [companyId], references: [id])
  vessel        Vessel               @relation(fields: [vesselId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notifications Notification[]
  tickets       SupportTicket[]

  @@index([vesselId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([companyId, contentHash, status])
  @@map("orders")
}

model OrderItem {
  id       Int     @id @default(autoincrement())
  orderId  Int     @map("order_id")
  partId   Int     @map("part_id")
  quantity Int
  price    Decimal @db.Decimal(12, 2)
  // зарезервировано со склада (для позиций «под заказ» резерв не берётся)
  reserved Boolean @default(true)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id])

  @@unique([orderId, partId])
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  status      OrderStatus
  comment     String?
  changedById String?     @map("changed_by") @db.Uuid
  changedAt   DateTime    @default(now()) @map("changed_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model AuthCode {
  id         Int       @id @default(autoincrement())
  login      String // нормализованный телефон или почта
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([login, createdAt])
  @@map("auth_codes")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Notification {
  id        Int                 @id @default(autoincrement())
  channel   NotificationChannel
  recipient String
  subject   String?
  body      String
  status    NotificationStatus
  provider  String // smsru / smtp / log
  error     String?
  orderId   Int?                @map("order_id")
  createdAt DateTime            @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("notifications")
}

/// Обращение в техподдержку (этап 7): вопрос, ошибка, вопрос по заказу или предложение по развитию.
enum SupportCategory {
  QUESTION
  BUG
  ORDER
  IDEA
}

enum SupportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id          Int             @id @default(autoincrement())
  userId      String          @map("user_id") @db.Uuid
  companyId   String?         @map("company_id") @db.Uuid
  orderId     Int?            @map("order_id")
  category    SupportCategory
  message     String
  status      SupportStatus   @default(NEW)
  reply       String?
  repliedById String?         @map("replied_by_id") @db.Uuid
  repliedAt   DateTime?       @map("replied_at")
  platform    String? // android / iphone / web
  appVersion  String?         @map("app_version")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user      User     @relation("TicketAuthor", fields: [userId], references: [id])
  repliedBy User?    @relation("TicketReplier", fields: [repliedById], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_tickets")
}
