{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "diagnostics": { "warnOnly": false } }] },
  "setupFiles": ["<rootDir>/env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testTimeout": 60000
}
